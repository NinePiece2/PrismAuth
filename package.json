{
  "name": "prismauth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html,mdx}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --config ./prisma/prisma.config.ts",
    "db:studio": "prisma studio --config ./prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma/prisma.config.ts",
    "db:seed": "bun prisma/seed.ts",
    "create:admin": "bun scripts/create-admin.ts",
    "generate:keys": "bun scripts/generate-keys.ts",
    "quickstart": "powershell -ExecutionPolicy Bypass -File ./scripts/quickstart.ps1",
    "predev": "bun run format",
    "prebuild": "bun run format"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.6.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7"
  }
}
