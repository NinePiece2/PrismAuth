{
  "name": "prismauth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html,mdx}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --config ./prisma/prisma.config.ts",
    "db:studio": "prisma studio --config ./prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma/prisma.config.ts",
    "db:seed": "bun prisma/seed.ts",
    "create:admin": "bun scripts/create-admin.ts",
    "generate:keys": "bun scripts/generate-keys.ts",
    "quickstart": "powershell -ExecutionPolicy Bypass -File ./scripts/quickstart.ps1",
    "predev": "bun run format",
    "prebuild": "bun run format && bun run lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "ioredis": "^5.11.1",
    "iron-session": "^8.0.3",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7"
  }
}
